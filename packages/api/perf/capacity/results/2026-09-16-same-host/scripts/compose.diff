--- a/docker-compose.capacity.yml (9dca6c525)	2026-09-16 10:42:05
+++ b/docker-compose.capacity.yml	2026-09-16 10:25:09
@@ -23,7 +23,7 @@
     environment:
       POSTGRES_DB: trueppm
       POSTGRES_USER: trueppm
-      POSTGRES_PASSWORD: capacity
+      POSTGRES_PASSWORD: ${CAPACITY_DB_PASSWORD}
     # Defaults tuned off the 8 GiB Docker VM this envelope was measured on, so
     # the database is not the accidental bottleneck. Recorded in the results
     # metadata — a different host needs these re-stated, not silently inherited.
@@ -34,6 +34,7 @@
       -c effective_cache_size=3GB
       -c work_mem=16MB
       -c maintenance_work_mem=256MB
+      -c jit=${CAPACITY_PG_JIT:-on}
     volumes:
       - capacity_pgdata:/var/lib/postgresql/data
     ports:
@@ -58,7 +59,7 @@
       sh -c "python manage.py migrate --noinput &&
              python manage.py create_admin"
     environment: &api_env
-      DATABASE_URL: postgres://trueppm:capacity@db:5432/trueppm
+      DATABASE_URL: postgres://trueppm:${CAPACITY_DB_PASSWORD}@db:5432/trueppm
       REDIS_URL: redis://valkey:6379
       DJANGO_SETTINGS_MODULE: trueppm_api.settings.prod
       # 50 chars — clears the strong-key boot guard (#566).
@@ -131,7 +132,7 @@
       <<: *api_env
       PYTHONPATH: /app/src
     volumes:
-      - ../../src:/app/src:ro
+      - ${CAPACITY_SRC:?absolute path to the arm's packages/api/src}:/app/src:ro
     depends_on:
       db:
         condition: service_healthy
