ios/Pods/
android/.gradle/
android/app/build/
android/build/
*.keystore
!debug.keystore

# Detox run artifacts — the suite itself returns with the native projects (#1599)
artifacts/

# EAS / Expo
.expo/

# Env / secrets
.env*.local

# IDE / OS
.DS_Store
*.pem
