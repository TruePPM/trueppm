---
// The TruePPM mark and wordmark, shared by the header and the 404 page.
//
// The mark geometry is copied unmodified from packages/web/brand/assets/mark.svg
// (the reference copy; see packages/web/brand/TRADEMARK.md). Only the node fill
// follows the theme, between the brand's own `mark` and `mark-reversed`
// variants, through --tp-docs-mark-node. Do not redraw or recolor it.
---

<span class="tp-brand" translate="no">
  <svg width="26" height="26" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
    <line x1="19" y1="45" x2="35" y2="31" stroke="#4FA884" stroke-width="7" stroke-linecap="round"></line>
    <polygon points="42,23 39.67,36.44 28.53,24.96" fill="#4FA884"></polygon>
    <circle cx="15" cy="49" r="7" fill="var(--tp-docs-mark-node)"></circle>
    <circle cx="49" cy="16" r="9.5" fill="var(--tp-docs-mark-node)"></circle>
  </svg>
  <span class="tp-wordmark"><span>True</span><span class="tp-wordmark-ppm">PPM</span></span>
</span>

<style>
  .tp-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  svg {
    flex-shrink: 0;
  }
  .tp-wordmark {
    font-family: "Space Grotesk", "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--tp-docs-ink);
  }
  .tp-wordmark-ppm {
    color: #4fa884;
  }
</style>
