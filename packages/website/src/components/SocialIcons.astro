---
// Starlight's social icons, preceded by a text link back to the marketing site
// (shown at 50em and up; the mobile menu keeps the icons only).
import Default from "@astrojs/starlight/components/SocialIcons.astro";
---

<a href="https://trueppm.com" class="tp-home-link">trueppm.com</a>
<Default><slot /></Default>

<style>
  .tp-home-link {
    display: none;
    /* The flex gap is 1rem; the extra 4px makes the 20px the design asks for. */
    margin-inline-end: 4px;
    font-weight: 500;
    font-size: 14px;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .tp-home-link:hover {
    color: var(--sl-color-white);
  }
  @media (min-width: 50em) {
    .tp-home-link {
      display: inline-block;
      padding-block: 4px;
    }
  }
</style>
