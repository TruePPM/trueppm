# TruePPM production environment — copy to .env and fill in values.
#   cp .env.example .env
#   chmod 600 .env

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=trueppm.example.com

# ── TLS ─────────────────────────────────────────────────────────────────────
# letsencrypt | selfsigned | none
TLS_MODE=letsencrypt
# Required only when TLS_MODE=letsencrypt
CERTBOT_EMAIL=ops@example.com
#
# The certbot renewal service is gated behind a compose profile, so it is only
# created while that profile is active. init-prod.sh writes this line for you
# when TLS_MODE=letsencrypt — docker compose reads COMPOSE_PROFILES from this
# file on every invocation, which is what carries renewal into a later plain
# `docker compose up -d` and into the documented systemd unit. Delete it and the
# stack keeps serving HTTPS while quietly never renewing, until the certificate
# expires ~90 days later. Verify with:
#   docker compose -f docker-compose.prod.yml ps certbot
# COMPOSE_PROFILES=letsencrypt

# ── Django ───────────────────────────────────────────────────────────────────
# REQUIRED: at least 32 characters. Production refuses to boot otherwise (#566).
#
# LEAVE THIS EMPTY and ./init-prod.sh generates one and writes it back here. It
# ships empty on purpose (#3187): the placeholder that used to sit here was 56
# characters and did not start with "django-insecure-", so it passed every guard
# — and JWT_SIGNING_KEY defaults to SECRET_KEY, so a verbatim `cp .env.example
# .env` produced a production install whose token-signing key was published in
# this repository. Anyone could forge an access token for any user.
#
# To set it yourself instead:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Rotating it later invalidates every session and every issued JWT (users must
# log in again) but touches no stored data.
SECRET_KEY=

# Every hostname a request can arrive under, including the ones your own
# infrastructure uses. Django validates the Host header in get_host() BEFORE any
# view runs and answers 400 DisallowedHost on a miss — which reads like a routing
# bug, not a config one, because nothing in the response names this variable.
#
# `localhost` and `127.0.0.1` are NOT optional here: the api container's
# healthcheck curls http://localhost:8000/api/v1/health/
# (docker-compose.prod.yml), so dropping them leaves the container reporting
# `unhealthy` forever while the site itself serves fine (#3183).
#
# Add your real hostname; keep the loopback entries. No scheme, no port, no path.
#   ALLOWED_HOSTS=ppm.example.com,localhost,127.0.0.1
#
# https://docs.trueppm.com/administration/configuration/
ALLOWED_HOSTS=trueppm.example.com,localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED: production refuses to boot on a placeholder or short password (#3176).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
# Production REFUSES TO BOOT when DATABASE_URL has no sslmode parameter (#1550) —
# the connection could otherwise fall back to unencrypted transport. Append
# ?sslmode=require to DATABASE_URL, OR set TRUEPPM_ALLOW_UNENCRYPTED_DB=true if
# TLS to the database is enforced at the network layer (a warning is logged in
# that case).
#
# You do NOT need to set either one here for the bundled compose stack.
# docker-compose.prod.yml composes DATABASE_URL for the bundled postgres and
# sets TRUEPPM_ALLOW_UNENCRYPTED_DB=true next to it, because that container
# publishes no host port and is reachable only on the private compose bridge
# network. Note that both are set in the services' `environment:` blocks, which
# take precedence over this file — overriding them from .env has no effect.
#
# If you repoint the stack at an EXTERNAL database, edit docker-compose.prod.yml:
# replace DATABASE_URL on api-init/api/celery/celery-beat and DELETE the
# TRUEPPM_ALLOW_UNENCRYPTED_DB line from each, so the sslmode guard stays live on
# a hop that actually crosses the network.

# ── Redis ────────────────────────────────────────────────────────────────────
# REQUIRED: same guard as DB_PASSWORD above.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Email for the first superuser (password is auto-generated and written to
# TRUEPPM_ADMIN_PASSWORD_FILE; retrieve with the command in init-prod.sh).
DJANGO_SUPERUSER_EMAIL=admin@trueppm.example.com

# ── Integrations ─────────────────────────────────────────────────────────────
# REQUIRED — production REFUSES TO BOOT without this (#1002). A Fernet key used
# to encrypt stored integration credentials (e.g. GitHub/GitLab PATs) at rest.
# Generate one and paste it below (do NOT leave this empty):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# ── Attachment storage ───────────────────────────────────────────────────────
# REQUIRED CHOICE — production REFUSES TO BOOT until you pick one (#775). Task
# attachments default to local FileSystemStorage, which is EPHEMERAL in a
# containerized deploy (and unwritable in the bundled compose deploy, whose api
# container runs with a read-only root filesystem and no attachments volume).
# Uncomment exactly ONE of the two lines below:
#
#   (a) Recommended — persistent object storage. The S3 backend ships in the API
#       image; the bucket name is REQUIRED alongside it (startup fails with
#       trueppm.E008 without one, rather than failing on the first upload):
# TRUEPPM_DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage
# TRUEPPM_S3_BUCKET_NAME=trueppm-attachments
#       For a non-AWS endpoint (MinIO, Ceph, Wasabi) add:
# TRUEPPM_S3_ENDPOINT_URL=http://minio:9000
# TRUEPPM_S3_ADDRESSING_STYLE=path
# TRUEPPM_S3_ACCESS_KEY_ID=your-access-key
# TRUEPPM_S3_SECRET_ACCESS_KEY=your-secret-key
#       Use a credential scoped to the attachments bucket, NOT the MinIO root
#       account (minioadmin/minioadmin out of the box — change it, and still do
#       not use it here). TruePPM only needs get/put/delete on the bucket.
#       On AWS, omit the credentials to use the SDK chain (IRSA / instance
#       profile). Full variable list: docs/administration/configuration.
#
#   (b) Local disk. docker-compose.prod.yml mounts the named `media` volume at
#       /var/lib/trueppm/media for this, so it works out of the box on a
#       single-server install — but the files live only on that server, so they
#       are yours to back up (scripts/backup.sh includes them when
#       TRUEPPM_MEDIA_ROOT is set) and they do not survive
#       `docker compose down -v`:
# TRUEPPM_ALLOW_LOCAL_ATTACHMENT_STORAGE=true
#       Where those files are written — and not only attachments: the workspace
#       logo and the project/program/workspace export bundles land here too.
#       The default matches the volume mount in
#       docker-compose.prod.yml; change both together or the API refuses to
#       start, because it probes this path for writability at boot rather than
#       failing on the first upload. Ignored entirely on object storage.
# TRUEPPM_MEDIA_ROOT=/var/lib/trueppm/media

# ── Cross-origin / CSRF ──────────────────────────────────────────────────────
# Required only when the web app is served from a different origin than the API
# (split-origin or subdomain-split deploy). Comma-separated, scheme included.
#   CSRF_TRUSTED_ORIGINS=https://app.trueppm.example.com,https://api.trueppm.example.com
# CSRF_TRUSTED_ORIGINS=

# ── Frontend base URL (email deep-links) ─────────────────────────────────────
# Public origin the web app is served from. Used to build absolute task links in
# notification emails (e.g. task.blocked). Leave unset to omit links — emails
# still carry blocker type/age/actor. No trailing slash, no path.
# Standardized on the TRUEPPM_ prefix pre-0.3 (#1355); the legacy bare
# FRONTEND_BASE_URL still works as a fallback.
#   TRUEPPM_FRONTEND_BASE_URL=https://trueppm.example.com
# TRUEPPM_FRONTEND_BASE_URL=

# ── Auth refresh cookie ──────────────────────────────────────────────────────
# The JWT refresh token rides in an httpOnly, Secure, SameSite=Strict cookie
# (never exposed to JavaScript, so XSS cannot steal it). The access token is held
# in browser memory only. These defaults are correct for a standard same-origin
# HTTPS deploy — leave them unset. Standardized on the TRUEPPM_ prefix pre-0.3
# (#1355); the legacy bare names (AUTH_REFRESH_COOKIE_*) still work as fallbacks.
#
# SECURE defaults to true; the browser drops a Secure cookie over plain HTTP, so
# only set it false on a non-HTTPS dev/preview host (the dev settings already do
# this for localhost).
# TRUEPPM_AUTH_REFRESH_COOKIE_SECURE=true
#
# SameSite=Strict blocks the cookie on any cross-site request. A split-origin
# deploy (web served from a different origin than the API) must relax this to
# "Lax" or "None" so the refresh request carries the cookie; with "None" the
# cookie must also be Secure (HTTPS).
# TRUEPPM_AUTH_REFRESH_COOKIE_SAMESITE=Strict
#
# Cookie name and the path it is scoped to (the refresh endpoint). Override only
# if you reverse-proxy the API under a non-default base path.
# TRUEPPM_AUTH_REFRESH_COOKIE_NAME=trueppm_refresh
# TRUEPPM_AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/

# ── Content-Security-Policy ──────────────────────────────────────────────────
# A strict CSP header (including frame-ancestors 'none') is sent on every API
# response. The defaults work for a standard same-origin deploy where the SPA is
# served from the same origin as the API.
#
# CSP_CONNECT_SRC controls which origins the browser may open XHR / fetch /
# WebSocket connections to. The default is "'self' wss:". If you serve the SPA
# from a DIFFERENT origin than the API (split-origin), add that API origin and
# its wss:// origin so the browser is allowed to reach them. Space-separated,
# each source quoted as CSP expects.
#   CSP_CONNECT_SRC='self' https://api.trueppm.example.com wss://api.trueppm.example.com
# CSP_CONNECT_SRC='self' wss:

# ── Image version ────────────────────────────────────────────────────────────
# PIN THIS to a released tag. `latest` makes deploys non-reproducible — two
# `docker compose pull`s a week apart give you different code with no record of
# what changed — and it makes the documented rollback impossible: upgrade.md
# says "restore the previous APP_VERSION", and there is nothing to restore if it
# was never pinned. Releases are at
# https://gitlab.com/trueppm/trueppm/-/releases (#3189).
#   APP_VERSION=v0.3.0-alpha.3
APP_VERSION=latest
