# Auto detect text files and ensure LF line endings
* text=auto eol=lf

# Explicit text files
*.md    text
*.txt   text
*.yml   text
*.yaml  text
*.json  text
*.toml  text
*.cfg   text
*.ini   text
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf

# Vendored Semgrep rule packs — fetched by scripts/update-semgrep-rules.sh, not
# hand-edited. Mark generated so diffs collapse and they're excluded from language stats.
.semgrep/*.yml linguist-generated=true

# Lock files — union merge to reduce conflicts
package-lock.json merge=union
yarn.lock         merge=union
uv.lock           merge=union

# Binary files — no diff, no merge
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary

# Encoding fixtures — the bytes ARE the test (#2892, #2937). These exercise the
# decode boundary, so `text=auto` normalizing CRLF (or a future edit "fixing" the
# encoding) would quietly void them. The UTF-16 ones survive today only because
# their NUL bytes make git detect them as binary; the UTF-8 and cp1252 ones do
# not, so make it explicit for all of them rather than rely on that.
packages/api/tests/apps/csvimport/files/*.csv  -text binary
packages/api/tests/apps/projects/files/*.csv   -text binary
