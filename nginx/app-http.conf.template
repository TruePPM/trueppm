# TruePPM production nginx config — HTTP-only (TLS_MODE=none).
#
# WARNING: This serves TruePPM over plain HTTP with no encryption.
# Session cookies and API traffic will NOT be encrypted.
# Use only for air-gapped networks, internal staging, or deployments
# where TLS is terminated by an upstream load balancer.
# Do NOT use for deployments reachable from the public internet.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Preserve an upstream load balancer's X-Forwarded-Proto instead of overwriting
# it (#3191).
#
# This config is the TLS-terminated-upstream shape, so $scheme here is always
# "http" — the LB already stripped TLS before reaching us. Sending
# `X-Forwarded-Proto $scheme` therefore told Django "this request arrived over
# plain HTTP" on a connection the user made over HTTPS.
#
# Django's SECURE_PROXY_SSL_HEADER is ("HTTP_X_FORWARDED_PROTO", "https"), so
# request.is_secure() returned False for every request: secure-only cookies were
# withheld, HSTS was never emitted, and TRUEPPM_SECURE_SSL_REDIRECT=true became
# an infinite redirect loop (the app redirects to https, the LB terminates it and
# forwards http again, forever).
#
# Trust an incoming value only when one is present; fall back to $scheme when it
# is absent, so a direct-to-nginx deployment is unchanged. Only set this in front
# of a proxy you control — X-Forwarded-Proto is client-spoofable otherwise, and
# TRUEPPM_NUM_PROXIES governs how far up the X-Forwarded-For chain the app trusts.
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    ~.      $http_x_forwarded_proto;
}

limit_req_zone $binary_remote_addr zone=admin_login:1m rate=5r/m;

server {
    listen 80;
    server_name ${DOMAIN};

    add_header X-Frame-Options        "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self'; frame-ancestors 'none'" always;

    # 110M, not 50M (#3189). The largest application cap is the ATTACHMENT one:
    # serializers.py sets MAX_ATTACHMENT_SIZE_BYTES = 100 MB and
    # settings/base.py sets DATA_UPLOAD_MAX_MEMORY_SIZE to the same, with a
    # comment instructing operators to set nginx to 100m. At 50M every
    # attachment between 50 and 100 MB got a bare nginx 413 on every deployment
    # path — the documented feature was capped at half its documented size, and
    # the rejection never reached the app that could name the limit.
    #
    # 110 rather than 100: multipart framing and headers add a few KB, so at
    # exactly 100M a legal 100 MB upload still 413s. The app cap remains the
    # enforcement point; this is headroom above it, which is what the earlier
    # comment here claimed 50M was and was not.
    client_max_body_size 110M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    root  /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass         http://api:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 90s;
    }

    location /ws/ {
        proxy_pass             http://api:8000;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout     86400s;
    }

    # Django admin — DENIED here, and that is the whole control. See the long
    # note in nginx/app.conf.template: `allow 127.0.0.1` could never match,
    # because nginx tests $remote_addr and a request through a published port
    # carries the Docker bridge gateway's address, so the SSH tunnel this block
    # used to document produced a 403 (#3189). It failed closed, so it was never
    # a vulnerability — it was a control that read as conditional while being
    # absolute.
    #
    # TO REACH DJANGO ADMIN, go at the API container, which is not behind this
    # nginx:
    #   ssh -L 8000:127.0.0.1:8000 user@yourserver
    #   docker compose -f docker-compose.prod.yml run --rm --service-ports \
    #     -p 127.0.0.1:8000:8000 api
    location /admin/ {
        deny all;

        limit_req zone=admin_login burst=2 nodelay;

        proxy_pass       http://api:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /static/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }
}
