# TruePPM production nginx config — HTTP-only (TLS_MODE=none).
#
# WARNING: This serves TruePPM over plain HTTP with no encryption.
# Session cookies and API traffic will NOT be encrypted.
# Use only for air-gapped networks, internal staging, or deployments
# where TLS is terminated by an upstream load balancer.
# Do NOT use for deployments reachable from the public internet.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Preserve an upstream load balancer's X-Forwarded-Proto instead of overwriting
# it (#3191).
#
# This config is the TLS-terminated-upstream shape, so $scheme here is always
# "http" — the LB already stripped TLS before reaching us. Sending
# `X-Forwarded-Proto $scheme` therefore told Django "this request arrived over
# plain HTTP" on a connection the user made over HTTPS.
#
# Django's SECURE_PROXY_SSL_HEADER is ("HTTP_X_FORWARDED_PROTO", "https"), so
# request.is_secure() returned False for every request: secure-only cookies were
# withheld, HSTS was never emitted, and TRUEPPM_SECURE_SSL_REDIRECT=true became
# an infinite redirect loop (the app redirects to https, the LB terminates it and
# forwards http again, forever).
#
# Trust an incoming value only when one is present; fall back to $scheme when it
# is absent, so a direct-to-nginx deployment is unchanged. Only set this in front
# of a proxy you control — X-Forwarded-Proto is client-spoofable otherwise, and
# TRUEPPM_NUM_PROXIES governs how far up the X-Forwarded-For chain the app trusts.
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    ~.      $http_x_forwarded_proto;
}

limit_req_zone $binary_remote_addr zone=admin_login:1m rate=5r/m;

server {
    listen 80;
    server_name ${DOMAIN};

    add_header X-Frame-Options        "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    # #3553 — see packages/web/nginx.conf for the rationale.
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self'; frame-ancestors 'none'" always;

    # Request-body ceiling (#4383). 2M is the DEFAULT tier of
    # packages/api/src/trueppm_api/core/request_body_limits.py and Django's
    # DATA_UPLOAD_MAX_MEMORY_SIZE: the largest JSON body any endpoint parses,
    # including the unauthenticated login/invite/reset routes, which used to
    # accept 110M. The routes that genuinely take more (attachments 110M,
    # imports 110M, sync/bulk/seed/logo 10M) raise it per location inside
    # `location /api/` below. The app enforces the same tiers itself, so an
    # Ingress that bypasses this nginx still meets them.
    client_max_body_size 2M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    root  /usr/share/nginx/html;
    index index.html;

    # Caching (#4350). Hashed filenames make these two cases opposite: a hit is
    # safe to cache forever (a new build ships under a new hash), while a miss
    # must never be cached — a CDN that cached a transient 404 for a chunk a
    # rolling pod has not finished serving yet would keep returning it long
    # after every pod has the file, turning a few-second skew window into
    # minutes to hours. `add_header` is replace-not-merge per location
    # (#2849), so every location below that introduces one repeats the full
    # security-header set rather than silently dropping it.
    #
    # Hashed build output must never fall through to the SPA index.html: during a
    # rolling update a client can ask a pod for a chunk only the other release has,
    # and a 200 text/html answer blank-screens the app silently. A real 404 lets
    # the client's chunk-load handler reload (#4341).
    location /assets/ {
        try_files $uri @assets_404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Frame-Options        "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self'; frame-ancestors 'none'" always;
    }

    # Named target of the try_files fallback above — never reached directly.
    # `no-store` so a CDN never caches a transient miss during a rollout.
    location @assets_404 {
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options        "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self'; frame-ancestors 'none'" always;
        return 404;
    }

    # The SPA shell. `no-cache` (NOT no-store): always revalidate with the
    # origin, but the conditional request is cheap because nginx still emits
    # ETag/Last-Modified — a heuristically-fresh cached shell is exactly what
    # names a chunk no pod has any more (#4341, #4350).
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options        "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws:; font-src 'self'; frame-ancestors 'none'" always;
    }

    # Build-specific readiness sentinel (#4359): `=404`, never the SPA
    # fallback below — a build missing its manifest must fail a probe, not
    # answer 200 with index.html. Parity with the Helm configmap (#4392).
    location = /asset-manifest.json {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass         http://api:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 90s;

        # Per-route body ceilings (#4383) — this nesting mirrors the table in
        # packages/api/src/trueppm_api/core/request_body_limits.py, and
        # tests/core/test_request_body_limits.py fails if the two disagree. Every
        # other /api/ route keeps the 2M server-level default. The nested locations
        # inherit every proxy_set_header above (none is redeclared), but
        # proxy_pass is not inherited and must be repeated.
        location ~ ^/api/v1/projects/([^/]+/tasks/[^/]+/attachments|[^/]+/import/(msproject|jira|csv|csv/preview)|import/msproject|[^/]+/risks/import)/$ {
            client_max_body_size 110M;
            proxy_pass http://api:8000;
        }
        location ~ ^/api/v1/(workspace/logo|programs/import(/validate)?|projects/[^/]+/(tasks/bulk|sync|task-sync))/$ {
            client_max_body_size 10M;
            proxy_pass http://api:8000;
        }
    }

    location /ws/ {
        proxy_pass             http://api:8000;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout     86400s;
    }

    # Django admin — DENIED here, and that is the whole control. See the long
    # note in nginx/app.conf.template: `allow 127.0.0.1` could never match,
    # because nginx tests $remote_addr and a request through a published port
    # carries the Docker bridge gateway's address, so the SSH tunnel this block
    # used to document produced a 403 (#3189). It failed closed, so it was never
    # a vulnerability — it was a control that read as conditional while being
    # absolute.
    #
    # TO REACH DJANGO ADMIN, go at the API container, which is not behind this
    # nginx:
    #   ssh -L 8000:127.0.0.1:8000 user@yourserver
    #   docker compose -f docker-compose.prod.yml run --rm --service-ports \
    #     -p 127.0.0.1:8000:8000 api
    location /admin/ {
        deny all;

        limit_req zone=admin_login burst=2 nodelay;

        proxy_pass       http://api:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /static/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }
}
