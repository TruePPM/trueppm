# TruePPM production nginx config — HTTPS (TLS_MODE=letsencrypt or selfsigned).
# Rendered by envsubst at nginx container startup; $DOMAIN is substituted.
# Selected by init-prod.sh when TLS_MODE != none.

# Upgrade WebSocket connections; pass Connection: close for normal HTTP.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Rate-limit zone for the Django admin login — defence-in-depth even though
# /admin/ is already restricted to loopback at the Nginx layer.
# 5 requests/min per IP; burst of 2.
limit_req_zone $binary_remote_addr zone=admin_login:1m rate=5r/m;

# HTTP — serve the ACME challenge and redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options           "DENY" always;
    add_header X-Content-Type-Options    "nosniff" always;
    # #3553 — see packages/web/nginx.conf for the rationale.
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'" always;

    # Request-body ceiling (#4383). 2M is the DEFAULT tier of
    # packages/api/src/trueppm_api/core/request_body_limits.py and Django's
    # DATA_UPLOAD_MAX_MEMORY_SIZE: the largest JSON body any endpoint parses,
    # including the unauthenticated login/invite/reset routes, which used to
    # accept 110M. The routes that genuinely take more (attachments 110M,
    # imports 110M, sync/bulk/seed/logo 10M) raise it per location inside
    # `location /api/` below. The app enforces the same tiers itself, so an
    # Ingress that bypasses this nginx still meets them.
    client_max_body_size 2M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # SPA — serve the React bundle; fall back to index.html for client-side routes.
    root  /usr/share/nginx/html;
    index index.html;

    # Caching (#4350). Hashed filenames make these two cases opposite: a hit is
    # safe to cache forever (a new build ships under a new hash), while a miss
    # must never be cached — a CDN that cached a transient 404 for a chunk a
    # rolling pod has not finished serving yet would keep returning it long
    # after every pod has the file, turning a few-second skew window into
    # minutes to hours. `add_header` is replace-not-merge per location
    # (#2849), so every location below that introduces one repeats the full
    # security-header set rather than silently dropping it.
    #
    # Hashed build output must never fall through to the SPA index.html: during a
    # rolling update a client can ask a pod for a chunk only the other release has,
    # and a 200 text/html answer blank-screens the app silently. A real 404 lets
    # the client's chunk-load handler reload (#4341).
    location /assets/ {
        try_files $uri @assets_404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options           "DENY" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'" always;
    }

    # Named target of the try_files fallback above — never reached directly.
    # `no-store` so a CDN never caches a transient miss during a rollout.
    location @assets_404 {
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options           "DENY" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'" always;
        return 404;
    }

    # The SPA shell. `no-cache` (NOT no-store): always revalidate with the
    # origin, but the conditional request is cheap because nginx still emits
    # ETag/Last-Modified — a heuristically-fresh cached shell is exactly what
    # names a chunk no pod has any more (#4341, #4350).
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options           "DENY" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; frame-ancestors 'none'" always;
    }

    # Build-specific readiness sentinel (#4359): `=404`, never the SPA
    # fallback below — a build missing its manifest must fail a probe, not
    # answer 200 with index.html. Parity with the Helm configmap (#4392).
    location = /asset-manifest.json {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API
    #
    # X-Forwarded-Proto $scheme (not the $forwarded_proto map nginx/app-http.conf.template
    # and nginx/demo.conf.template use, #4426): THIS config terminates TLS itself
    # (`listen 443 ssl` above) — $scheme is already correct here, because nginx is the
    # client-facing edge. Trusting an incoming X-Forwarded-Proto header instead would let a
    # plain-HTTP client on this same listener simply claim "https" and spoof a secure
    # request. The overwrite bug #4426 fixed only applies behind a TLS-terminating
    # upstream (TLS_MODE=none → nginx/app-http.conf.template), which this template is not.
    location /api/ {
        proxy_pass         http://api:8000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;

        # Per-route body ceilings (#4383) — this nesting mirrors the table in
        # packages/api/src/trueppm_api/core/request_body_limits.py, and
        # tests/core/test_request_body_limits.py fails if the two disagree. Every
        # other /api/ route keeps the 2M server-level default. The nested locations
        # inherit every proxy_set_header above (none is redeclared), but
        # proxy_pass is not inherited and must be repeated.
        location ~ ^/api/v1/projects/([^/]+/tasks/[^/]+/attachments|[^/]+/import/(msproject|jira|csv|csv/preview)|import/msproject|[^/]+/risks/import)/$ {
            client_max_body_size 110M;
            proxy_pass http://api:8000;
        }
        location ~ ^/api/v1/(workspace/logo|programs/import(/validate)?|projects/[^/]+/(tasks/bulk|sync|task-sync))/$ {
            client_max_body_size 10M;
            proxy_pass http://api:8000;
        }
    }

    # WebSocket (Django Channels)
    location /ws/ {
        proxy_pass             http://api:8000;
        proxy_http_version     1.1;
        proxy_set_header       Upgrade           $http_upgrade;
        proxy_set_header       Connection        $connection_upgrade;
        proxy_set_header       Host              $host;
        proxy_set_header       X-Real-IP         $remote_addr;
        proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header       X-Forwarded-Proto $scheme;
        proxy_read_timeout     86400s;
    }

    # Django admin — DENIED at the Nginx layer, and that is the whole control.
    #
    # The `allow 127.0.0.1; allow ::1;` that used to sit here could never match
    # (#3189). nginx tests $remote_addr, which for a request arriving through a
    # published port is the DOCKER BRIDGE GATEWAY, not the client's address — so
    # the documented `ssh -L 8443:127.0.0.1:443` tunnel produced a 403 too. The
    # rule failed closed, so it was never a vulnerability; it was a control that
    # read as conditional while being absolute, and a documented procedure that
    # could not work. packages/web/nginx.conf records the same fact.
    #
    # Adding set_real_ip_from for the bridge would not rescue the tunnel either:
    # an SSH port-forward sends no X-Forwarded-For for nginx to read.
    #
    # TO REACH DJANGO ADMIN on this stack, go at the API container directly,
    # which is not behind this nginx at all:
    #   ssh -L 8000:127.0.0.1:8000 user@yourserver
    #   docker compose -f docker-compose.prod.yml run --rm --service-ports \
    #     -p 127.0.0.1:8000:8000 api
    #   then visit http://localhost:8000/admin/
    # Or use `docker compose exec api python manage.py shell` for one-off work.
    #
    # limit_req stays as defense in depth: if you replace `deny all` with your
    # own office CIDR, the rate limit is still there. Django admin is a plain
    # Django view, so no DRF throttle scope applies to it and there is no lockout
    # backend — and the bootstrap guarantees a superuser exists.
    location /admin/ {
        deny all;

        limit_req zone=admin_login burst=2 nodelay;

        proxy_pass       http://api:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django static files (admin CSS/JS, collectstatic output)
    location /static/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
    }
}
