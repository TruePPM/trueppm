#!/usr/bin/env bash
# scripts/wt — git worktree helper for parallel multi-issue work.
#
# Usage:
#   scripts/wt new <issue|branch-name>    Create a worktree + branch off origin/main.
#                                         Checks out the issue (status::wip label +
#                                         comment) so parallel agents don't grab it;
#                                         refuses an already-checked-out issue unless
#                                         --force is passed to take it over.
#                                         Auto-reserves an ADR number for feat/*
#                                         branches (--no-adr to skip; --adr to force
#                                         on any branch).
#   scripts/wt reserve adr                Atomically reserve the next free ADR number
#                                         and print it, so parallel worktrees can't
#                                         claim the same one. Recorded in a shared
#                                         ledger + the worktree's .wt-reservation.
#   scripts/wt reserve migration <app>    Same, for the next migration number in the
#                                         given Django app.
#   scripts/wt claim <issue> [--force]    Check out an issue WITHOUT creating a
#                                         worktree yet (you picked it up but haven't
#                                         started). Same lock as `new`.
#   scripts/wt release <issue>            Release an issue check-out (clear the label).
#   scripts/wt release-reservation <branch>
#                                         Drop ledger reservations held by a branch
#                                         that no longer exists (what `wt doctor`
#                                         reports). Refuses while the branch is live.
#   scripts/wt stash [push] [msg]         Stash this worktree's changes PRIVATELY.
#                                         `git stash` is NOT worktree-scoped: it uses
#                                         refs/stash in the shared git common dir, so
#                                         a pop in one worktree takes whatever another
#                                         pushed last — and drops it. Use this instead.
#   scripts/wt stash pop|apply|list|drop|show
#                                         Operate on THIS worktree's entries only.
#   scripts/wt list                       List active worktrees and WIP count.
#   scripts/wt remove <issue|name>        Remove a worktree by issue # or name; if the
#                                         issue is closed, clears its status::wip
#                                         check-out label too (left alone if the issue
#                                         is still open — e.g. removed without merging).
#   scripts/wt prune                      Remove worktrees whose branches were merged
#                                         to main and deleted on origin. Refuses to
#                                         remove worktrees with uncommitted work.
#                                         Releases each pruned worktree's check-out.
#   scripts/wt prune-dbs [--yes]          Drop test databases with no live worktree
#                                         behind them. Skips any database something
#                                         is still connected to.
#   scripts/wt doctor                     Verify symlinks and docker-stack reuse, and
#                                         report orphaned test databases.
#   scripts/wt help                       Show this help.
#
# Safe by construction: parallel agents can self-serve `wt new`/`wt remove`
# without a human coordinating checkouts. Three structural guards, not process
# discipline, keep one agent from stomping another's worktree:
#   1. New branches are created with --no-track (no upstream to origin/main), so a
#      fresh, uncommitted, unpushed worktree is never confused with a merged-and-
#      deleted branch — the bug that made `wt prune` reap fresh worktrees.
#   2. Each worktree carries a `.wt-owner` marker; `wt prune` honors a freshness
#      grace window (TRUEPPM_WT_GRACE_MIN, default 30) and refuses to reap a
#      worktree younger than it unless --force.
#   3. Each worktree gets its OWN Postgres test DB (TRUEPPM_TEST_DB in .envrc), so
#      parallel `pytest` runs never collide — no external mutex required. That DB
#      is dropped by `wt remove`/`wt prune`: pytest-django only drops it on a
#      CLEAN exit, so an interrupted run would otherwise strand it forever, and
#      under xdist strand the whole `_gw0..gwN` worker family with it (#3270).
#   4. `wt stash` keeps stashes under refs/wt-stash/<worktree>, because git's own
#      refs/stash is shared across worktrees and a pop from the wrong one both
#      applies AND drops another session's work (#3110). `wt doctor` warns when
#      refs/stash is non-empty while several worktrees are active.
#
# Issue check-out lock: because all agents share one GitLab identity, an assignee
# or a claim-comment does not stop a parallel agent from grabbing the same issue.
# `wt new`/`wt claim` apply a `status::wip` scoped label plus a check-out comment
# as an advisory signal, and refuse an issue that already carries it. The lock is
# best-effort visibility only — if glab is unavailable the worktree is still
# created (with a warning); correctness rests on the local guards above, not the
# label.
#
# Worktrees live at $TRUEPPM_WT_BASE (default: ../trueppm-wt relative to the
# main checkout). Each worktree symlinks packages/api/.venv and packages/web/node_modules
# back to the main checkout so dev deps aren't duplicated. The running Docker stack
# is shared via COMPOSE_PROJECT_NAME=trueppm, exported via .envrc for direnv users.
#
# WIP discipline: warns at 8 active worktrees, errors at 10. Override with
# TRUEPPM_WT_CAP if you really need more (you probably don't).

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

CURRENT_TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null || { echo "wt: not in a git repo" >&2; exit 1; })"
# REPO_ROOT must always point at the main checkout, even when this script is
# invoked from inside a secondary worktree. Use git-common-dir's parent: in the
# main checkout that's ".git" → "."; in a worktree that's "<main>/.git" → "<main>".
GIT_COMMON_DIR="$(git rev-parse --git-common-dir)"
case "$GIT_COMMON_DIR" in
  /*) REPO_ROOT="$(dirname "$GIT_COMMON_DIR")" ;;
  *)  REPO_ROOT="$(cd "$CURRENT_TOPLEVEL" && cd "$(dirname "$GIT_COMMON_DIR")" && pwd)" ;;
esac
WT_BASE="${TRUEPPM_WT_BASE:-${REPO_ROOT%/*}/trueppm-wt}"
WT_CAP="${TRUEPPM_WT_CAP:-10}"
WT_WARN="${TRUEPPM_WT_WARN:-8}"
COMPOSE_PROJECT_NAME_DEFAULT="trueppm"
# Scoped label used as the issue check-out lock. Scoped (key `status::`) so it is
# mutually exclusive with any other `status::*` label GitLab already carries.
WT_LOCK_LABEL="${TRUEPPM_WT_LOCK_LABEL:-status::wip}"
# Freshness grace window (minutes): `prune` refuses to reap a worktree younger
# than this unless --force. This is the structural guard that stops a parallel
# agent's just-created worktree — nothing committed or pushed yet — from being
# false-pruned out from under it. Set TRUEPPM_WT_GRACE_MIN=0 to disable.
WT_GRACE_MIN="${TRUEPPM_WT_GRACE_MIN:-30}"
WT_GRACE_SEC=$(( WT_GRACE_MIN * 60 ))
# Per-worktree owner/liveness marker, stamped at creation (see write_owner_marker).
WT_OWNER_FILE=".wt-owner"
# Per-worktree number-reservation marker (untracked). Records the ADR / migration
# numbers this worktree holds so the agent working in it can see them. Treated as
# auto-created by the remove/prune dirty checks, alongside .envrc and .wt-owner.
WT_RESERVATION_FILE=".wt-reservation"
# Shared number-reservation ledger + its lock, kept in the git COMMON dir so every
# worktree of this repo reads and writes the SAME file (a per-worktree file would
# defeat the whole point). GIT_COMMON_DIR may be relative (".git" in the main
# checkout) or absolute (in a secondary worktree); resolve to an absolute path the
# same way REPO_ROOT is derived above.
GIT_COMMON_DIR_ABS="$(cd "$CURRENT_TOPLEVEL" && cd "$GIT_COMMON_DIR" && pwd)"
WT_LEDGER="${GIT_COMMON_DIR_ABS}/trueppm-wt-reservations.tsv"
WT_LEDGER_LOCK="${GIT_COMMON_DIR_ABS}/trueppm-wt-reservations.lock"
# A crashed reservation leaves the mkdir-lock behind; break it once it's older
# than this (seconds) so the ledger can never wedge permanently.
WT_LEDGER_LOCK_STALE_SEC="${TRUEPPM_WT_LOCK_STALE_SEC:-30}"
# Ref namespace for `wt stash`. `git stash` writes refs/stash, which lives in the
# git COMMON dir and is therefore shared by every worktree — two worktrees see one
# stack, and a `pop` in one takes whatever the other pushed most recently (#3110).
# Entries here are keyed by worktree so they cannot be reached from anywhere else.
WT_STASH_NS="refs/wt-stash"

# --- Per-worktree Postgres test database ------------------------------------
# `wt new` writes TRUEPPM_TEST_DB=<prefix><slug> into .envrc and pytest creates
# that database on its first run in the worktree. pytest-django drops it on a
# CLEAN exit and only on a clean exit — an interrupted run (Ctrl-C, a timeout, a
# killed agent session) leaves it behind, and until #3270 nothing else ever
# dropped it: `remove`, `prune` and `doctor` were all blind to the database they
# had caused to exist. 78 orphans had accumulated locally, 97% of the cluster.
#
# Everything below is prefix-anchored on WT_TEST_DB_PREFIX so that neither the
# shared `test_trueppm` nor the dev `trueppm` database can ever be matched, let
# alone dropped.
WT_TEST_DB_PREFIX="${TRUEPPM_WT_TEST_DB_PREFIX:-test_trueppm_wt}"
# Reached with `docker exec` on the container name rather than `docker compose`,
# so this works from any worktree without resolving a compose file (cmd_doctor
# checks the api container the same way).
WT_DB_CONTAINER="${TRUEPPM_WT_DB_CONTAINER:-${COMPOSE_PROJECT_NAME_DEFAULT}-db-1}"
WT_DB_USER="${TRUEPPM_WT_DB_USER:-trueppm}"
# Maintenance DB to connect to while dropping others. Never a drop target.
WT_DB_MAINT="${TRUEPPM_WT_DB_MAINT:-trueppm}"

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

if [[ -t 1 ]]; then
  C_RED='\033[31m'; C_YELLOW='\033[33m'; C_GREEN='\033[32m'; C_DIM='\033[2m'; C_OFF='\033[0m'
else
  C_RED=''; C_YELLOW=''; C_GREEN=''; C_DIM=''; C_OFF=''
fi

err()  { printf "${C_RED}wt: %s${C_OFF}\n" "$*" >&2; }
warn() { printf "${C_YELLOW}wt: %s${C_OFF}\n" "$*" >&2; }
ok()   { printf "${C_GREEN}wt: %s${C_OFF}\n" "$*"; }
say()  { printf "%s\n" "$*"; }
dim()  { printf "${C_DIM}%s${C_OFF}\n" "$*"; }

die()  { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Slugify text: strip conventional-commit prefix, lowercase, drop non-alnum,
# collapse hyphens, cap length. The prefix strip keeps issue titles like
# "feat(web): foo bar baz" from becoming branch names like
# "feat-web-foo-bar-baz" that double the prefix once `feat/` is added.
slugify() {
  printf "%s" "$1" \
    | sed -E 's/^(feat|fix|chore|docs|test|refactor|perf|ci|build)(\([^)]*\))?:[[:space:]]*//' \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g' \
    | sed -E 's/^-+|-+$//g' \
    | cut -c1-40
}

# Derive a branch name from an arg. If the arg is purely numeric, it's an
# issue number — fetch its title via glab and build feat/<issue>-<slug>. If
# the arg already contains a slash, treat it as a full branch name.
derive_branch_name() {
  local input="$1"
  if [[ "$input" == */* ]]; then
    printf "%s" "$input"
    return
  fi
  if [[ "$input" =~ ^[0-9]+$ ]]; then
    if ! command -v glab >/dev/null 2>&1; then
      die "glab not installed; pass a full branch name like 'feat/$input-something'"
    fi
    local title
    title="$(glab issue view "$input" --output json 2>/dev/null \
             | python3 -c 'import json,sys; print(json.load(sys.stdin).get("title",""))' \
             || true)"
    if [[ -z "$title" ]]; then
      die "could not look up issue #$input via glab"
    fi
    local slug
    slug="$(slugify "$title")"
    printf "feat/%s-%s" "$input" "$slug"
    return
  fi
  # Anything else: treat as a slug, prefix with feat/.
  printf "feat/%s" "$(slugify "$input")"
}

# Count active worktrees (excludes the main checkout).
wt_count() {
  # grep -v exits 1 when it filters out every line — i.e. when the main checkout
  # is the only worktree. Under `set -o pipefail` that 1 propagates and `set -e`
  # would abort the whole script (silently, before the cap/warn checks run). The
  # `|| true` guard keeps the count at 0 in that case. Same fix as cmd_remove below.
  git -C "$REPO_ROOT" worktree list --porcelain \
    | awk '/^worktree /{print $2}' \
    | { grep -v "^${REPO_ROOT}$" || true; } \
    | wc -l \
    | tr -d ' '
}

# Find a worktree path by issue number or name fragment.
find_worktree() {
  local needle="$1"
  # Both greps exit 1 on no match (no other worktrees, or none matching needle).
  # Guard the chain with `|| true` so pipefail+`set -e` don't abort when the lookup
  # simply finds nothing — callers expect an empty string, not a crash.
  git -C "$REPO_ROOT" worktree list --porcelain \
    | awk '/^worktree /{print $2}' \
    | { grep -v "^${REPO_ROOT}$" | grep -E "/${needle}(-|$)" || true; } \
    | head -n1
}

# ---------------------------------------------------------------------------
# Worktree-private stash
# ---------------------------------------------------------------------------
#
# `git stash` is not worktree-scoped. It stores to `refs/stash`, which lives in
# the git COMMON dir, so every worktree of a repo shares ONE stack: worktree A
# pushes, worktree B pushes, and A's `pop` now applies B's work into A's tree.
# When that pop applies cleanly git also DROPS the entry, so B's uncommitted work
# is gone from the stash and mixed into an unrelated tree, with nothing in either
# session's output naming what happened. There is no pre-stash hook, so this
# cannot be caught where it occurs — it has to be replaced (#3110).
#
# The primitive that makes a private stash possible is `git stash create`: it
# builds the same stash commit `push` would, but writes NO ref. We store that
# commit under `refs/wt-stash/<slug>` ourselves. `git stash apply` accepts any
# stash-shaped commit, so restoring needs nothing special. `refs/stash` is never
# read or written by any of this.

# A stable, filesystem-derived key for the current worktree. The path is what
# distinguishes worktrees (two can sit on the same branch, and a branch can be
# renamed under a live worktree), so key on its basename plus a short hash of the
# full path — readable in `git for-each-ref` output, still unique.
wt_stash_slug() {
  local base hash
  base="$(basename "$CURRENT_TOPLEVEL" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-40)"
  hash="$(printf '%s' "$CURRENT_TOPLEVEL" | git hash-object --stdin | cut -c1-8)"
  printf '%s-%s' "${base:-worktree}" "$hash"
}

wt_stash_ref() { printf '%s/%s' "$WT_STASH_NS" "$(wt_stash_slug)"; }

# Every entry for THIS worktree, newest first. Entries are a chain: each new one
# records the previous as its second parent, exactly as refs/stash does, so the
# reflog of our ref is the stack.
wt_stash_entries() {
  git -C "$CURRENT_TOPLEVEL" reflog show "$(wt_stash_ref)" --format='%gd %gs' 2>/dev/null || true
}

wt_stash_has_entries() {
  [[ -n "$(git -C "$CURRENT_TOPLEVEL" rev-parse --verify --quiet "$(wt_stash_ref)" 2>/dev/null || true)" ]]
}

# ---------------------------------------------------------------------------
# Owner / freshness marker
# ---------------------------------------------------------------------------
#
# Each worktree carries a `.wt-owner` file stamped at creation with who made it
# and when. `prune` reads its `created` epoch to enforce the grace window so a
# just-created worktree (agent still starting up, nothing committed yet) is
# never reaped out from under a parallel session. `wt list` reads it for the AGE
# column. It's a plain key=value file, untracked by git — the dirty-checks in
# remove/prune ignore it alongside .envrc.

write_owner_marker() {
  local path="$1" branch="$2" issue="$3"
  {
    printf 'created=%s\n' "$(date +%s)"
    printf 'created_iso=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'host=%s\n' "$(hostname 2>/dev/null || echo unknown)"
    printf 'user=%s\n' "$(id -un 2>/dev/null || echo unknown)"
    printf 'branch=%s\n' "$branch"
    printf 'issue=%s\n' "${issue:--}"
    printf 'session=%s\n' "${CLAUDE_SESSION_ID:-${TERM_SESSION_ID:-unknown}}"
  } > "$path/$WT_OWNER_FILE" 2>/dev/null || true
}

# Read one key ($2) from a worktree's ($1) owner marker; empty if absent.
owner_field() {
  local path="$1" key="$2"
  [[ -f "$path/$WT_OWNER_FILE" ]] || return 0
  sed -n -E "s/^${key}=(.*)$/\1/p" "$path/$WT_OWNER_FILE" 2>/dev/null | head -n1
}

# Age of a worktree in seconds — from the owner marker's `created` epoch if
# present, else the directory mtime (GNU stat then BSD stat). Empty if unknown.
worktree_age_seconds() {
  local path="$1" created
  created="$(owner_field "$path" created)"
  if [[ -z "$created" ]]; then
    created="$(stat -c %Y "$path" 2>/dev/null || stat -f %m "$path" 2>/dev/null || true)"
  fi
  [[ "$created" =~ ^[0-9]+$ ]] || return 0
  printf '%s' "$(( $(date +%s) - created ))"
}

# True (0) if the worktree at $1 was created within the grace window.
within_grace() {
  local age
  (( WT_GRACE_SEC > 0 )) || return 1
  age="$(worktree_age_seconds "$1")"
  [[ "$age" =~ ^[0-9]+$ ]] || return 1
  (( age < WT_GRACE_SEC ))
}

# Human-friendly age: "3m", "2h", "5d" from a seconds count.
humanize_age() {
  local s="$1"
  [[ "$s" =~ ^[0-9]+$ ]] || { printf '?'; return; }
  if   (( s < 3600 ));  then printf '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf '%dh' $(( s / 3600 ))
  else                       printf '%dd' $(( s / 86400 )); fi
}

# True (0) if branch $1 has its OWN upstream recorded (i.e. it was pushed with
# `git push -u`). Distinct from tracking origin/main: with the --no-track create
# below, this config key is absent until the first push, so it's an honest
# "pushed?" signal for `wt list`.
branch_pushed() {
  git -C "$REPO_ROOT" config --get "branch.${1}.remote" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Number reservation ledger
# ---------------------------------------------------------------------------
#
# Parallel worktree agents each computed "next ADR = max(on main) + 1" and all
# landed on the SAME number, so the CI collision gate had to bounce the 2nd/3rd
# MR to renumber (the recurring three-way ADR / double-migration collisions). This
# ledger makes collisions structurally impossible for concurrent LOCAL worktrees:
# reserving a number is an atomic claim recorded in a shared file — kept in the git
# common dir so every worktree sees it — guarded by a portable mkdir-lock (flock(1)
# is absent on macOS). The next number is one past the max seen across three
# sources: the working tree, origin/main, and outstanding reservations. Collisions
# across machines / open MRs still fall to the CI lint:adr-collisions gate; this is
# the local first line of defense, not a replacement for it.
#
# Ledger rows are TSV: <kind>\t<key>\t<number>\t<branch>\t<iso8601>
#   kind   = adr | migration
#   key    = "-" for adr (one global sequence); the app name for migration (per-app)
#   number = zero-padded 4-digit string, e.g. 0217

# Acquire the ledger lock. `mkdir` is atomic on POSIX, so it doubles as the lock.
# Breaks a lock left behind by a crashed process once it is older than the stale
# window. Returns non-zero (with a warning) rather than blocking forever, so a
# wedged lock degrades to a possibly-racy reservation instead of a hang.
ledger_lock() {
  local waited=0 lock_age now
  while ! mkdir "$WT_LEDGER_LOCK" 2>/dev/null; do
    lock_age="$(stat -c %Y "$WT_LEDGER_LOCK" 2>/dev/null || stat -f %m "$WT_LEDGER_LOCK" 2>/dev/null || true)"
    now="$(date +%s)"
    if [[ "$lock_age" =~ ^[0-9]+$ ]] && (( now - lock_age > WT_LEDGER_LOCK_STALE_SEC )); then
      rmdir "$WT_LEDGER_LOCK" 2>/dev/null || true
      continue
    fi
    waited=$(( waited + 1 ))
    if (( waited > 100 )); then
      warn "reservation ledger lock busy >10s; proceeding without it (reservation may race)"
      return 1
    fi
    sleep 0.1
  done
  return 0
}

ledger_unlock() { rmdir "$WT_LEDGER_LOCK" 2>/dev/null || true; }

# Max integer read from stdin (one per line); 0 if empty. `$1+0` coerces the field
# numerically so a zero-padded "0217" reads as decimal 217 — awk does not treat a
# leading-zero string field as octal, so this is safe.
max_int() { awk '{ n=$1+0; if (n>m) m=n } END { print m+0 }'; }

# Highest 4-digit LEADING number among the basenames on stdin. Full paths are ok:
# the dir prefix is stripped first, so a 4-digit run inside a title (e.g. a year)
# can never outrank the real leading sequence number.
max_leading_number() { sed -E 's#.*/##' | grep -oE '^[0-9]{4}' | max_int; }

# All reserved numbers currently in the ledger for a kind+key.
ledger_numbers() {
  local kind="$1" key="$2"
  [[ -f "$WT_LEDGER" ]] || return 0
  awk -F'\t' -v k="$kind" -v key="$key" '$1==k && $2==key { print $3 }' "$WT_LEDGER" 2>/dev/null || true
}

# Next free ADR number (global sequence) as a zero-padded 4-digit string.
next_adr_number() {
  local max=0 n
  n="$( { ls "$REPO_ROOT/docs/adr" 2>/dev/null || true; } | max_leading_number || true )";                          (( n > max )) && max="$n"
  n="$( git -C "$REPO_ROOT" ls-tree -r --name-only origin/main -- docs/adr/ 2>/dev/null | max_leading_number || true )"; (( n > max )) && max="$n"
  n="$( ledger_numbers adr - | max_int || true )";                                                                   (( n > max )) && max="$n"
  printf '%04d' $(( max + 1 ))
}

# Next free migration number for a Django app as a zero-padded 4-digit string.
next_migration_number() {
  local app="$1" max=0 n
  local mig="packages/api/src/trueppm_api/apps/${app}/migrations"
  n="$( { ls "$REPO_ROOT/$mig" 2>/dev/null || true; } | max_leading_number || true )";                       (( n > max )) && max="$n"
  n="$( git -C "$REPO_ROOT" ls-tree -r --name-only origin/main -- "$mig/" 2>/dev/null | max_leading_number || true )"; (( n > max )) && max="$n"
  n="$( ledger_numbers migration "$app" | max_int || true )";                                                (( n > max )) && max="$n"
  printf '%04d' $(( max + 1 ))
}

# Append a reservation row. Caller holds the lock.
ledger_record() {
  local kind="$1" key="$2" number="$3" branch="$4" ts
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$key" "$number" "$branch" "$ts" >> "$WT_LEDGER"
}

# Drop every reservation row for a branch — called when its worktree is removed or
# pruned, so a reserved-but-unused number is freed for reuse.
ledger_release_branch() {
  local branch="$1"
  [[ -f "$WT_LEDGER" ]] || return 0
  ledger_lock || true
  local tmp="${WT_LEDGER}.$$.tmp"
  if awk -F'\t' -v b="$branch" '$4 != b' "$WT_LEDGER" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$WT_LEDGER"
  else
    rm -f "$tmp"
  fi
  ledger_unlock
}

# Reservation rows whose branch no longer exists anywhere (#3283).
#
# `wt remove` and `wt prune` both call `ledger_release_branch`, so the ordinary
# paths clean up after themselves. This finds what a path that BYPASSED wt left
# behind — a raw `git worktree remove`, a hand-deleted branch, a `wt new`
# interrupted after the reservation and before the worktree. Same reasoning as the
# orphaned-test-database check (#3270): the release path working is not the same
# as nothing ever being stranded.
#
# Conservative on purpose. A row is orphaned only when its branch is absent from
# ALL of: the worktree list, local refs, and origin. A branch that is merely
# unpushed is not orphaned — that is the common case for a live worktree, and
# reporting it would train people to ignore this.
orphan_reservations() {
  [[ -f "$WT_LEDGER" ]] || return 0
  local kind key number branch rest
  while IFS=$'\t' read -r kind key number branch rest; do
    [[ -n "${branch:-}" && "$branch" != "-" ]] || continue
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch" && continue
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch" && continue
    printf '%s\t%s\t%s\t%s\n' "$kind" "$key" "$number" "$branch"
  done < "$WT_LEDGER"
}

# Record a reservation into a worktree's untracked .wt-reservation marker so the
# agent working there can see which number it holds.
stamp_reservation() {
  local wt_path="$1" kind="$2" number="$3" key="${4:-}"
  if [[ "$kind" == "migration" ]]; then
    printf 'migration.%s=%s\n' "$key" "$number" >> "$wt_path/$WT_RESERVATION_FILE" 2>/dev/null || true
  else
    printf '%s=%s\n' "$kind" "$number" >> "$wt_path/$WT_RESERVATION_FILE" 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------------------
# Issue check-out lock
# ---------------------------------------------------------------------------
#
# Multi-agent collision guard. All agents share one GitLab identity, so an
# assignee or a claim-comment does not stop a parallel agent from grabbing the
# same issue. This lock uses the `status::wip` scoped label plus a check-out
# comment as the shared signal: `wt new`/`wt claim` refuse an already-claimed
# issue, and `wt remove`/`wt prune`/`wt release` clear it. All lock operations
# are best-effort — every one degrades to a warning (never a hard failure) when
# glab is missing or the API call fails, so worktree management never breaks on
# a network blip.

# ---------------------------------------------------------------------------
# Per-worktree test database (#3270)
# ---------------------------------------------------------------------------

# Is the shared stack's Postgres container up? Every DB helper below is
# best-effort: with no docker, or the stack down, they no-op silently. Tearing
# down a worktree must never fail because a database could not be reached.
db_available() {
  command -v docker >/dev/null 2>&1 || return 1
  [[ -n "$(docker ps --filter "name=^${WT_DB_CONTAINER}$" --format '{{.Names}}' 2>/dev/null || true)" ]]
}

# psql -tAc against the maintenance DB. Swallows errors by design (see above).
db_query() {
  docker exec -i "$WT_DB_CONTAINER" \
    psql -U "$WT_DB_USER" -d "$WT_DB_MAINT" -tAc "$1" 2>/dev/null || true
}

# Every database wt could own. Anchored regex rather than LIKE: the names are
# full of underscores, which LIKE would treat as single-character wildcards —
# `test_trueppm_wt%` as a LIKE pattern also matches `testXtrueppmYwt...`.
db_list_wt() {
  db_query "SELECT datname FROM pg_database WHERE datname ~ '^${WT_TEST_DB_PREFIX}' ORDER BY datname;"
}

# Total on-disk size of the named databases, human-readable. Empty if none.
db_total_size() {
  local names_sql="$1"
  db_query "SELECT pg_size_pretty(COALESCE(sum(pg_database_size(datname)),0)) FROM pg_database WHERE datname IN (${names_sql});"
}

# The test DB name this worktree was given, read from its .envrc. Must be called
# BEFORE the worktree is removed. awk (not `sed | head`) so there is no pipe to
# SIGPIPE under `set -o pipefail`.
worktree_test_db() {
  local path="$1"
  [[ -f "$path/.envrc" ]] || return 0
  awk -F= '/^export TRUEPPM_TEST_DB=/ { print $2; exit }' "$path/.envrc"
}

# Every database belonging to <base>: the name itself plus its pytest-xdist
# worker databases. xdist suffixes the test DB per worker, so ONE interrupted
# parallel run strands the whole `<base>_gw0..gwN` family rather than a single
# database — 23 of the 78 orphans found in #3270 were `_gw<N>` workers. Matching
# is done in bash against the real database list, so no pattern is interpolated
# into SQL.
test_db_family() {
  local base="$1" d
  [[ -n "$base" ]] || return 0
  db_list_wt | while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    if [[ "$d" == "$base" || "$d" == "${base}_gw"* ]]; then
      printf '%s\n' "$d"
    fi
  done
}

# Guard: only ever act on a name that starts with the wt prefix AND has
# something after it. `test_trueppm` (the shared DB) and `trueppm` (the dev DB)
# both fail this, so they cannot reach a DROP even if passed in by mistake.
is_wt_test_db() {
  case "$1" in
    "${WT_TEST_DB_PREFIX}"?*) return 0 ;;
    *) return 1 ;;
  esac
}

# Drop one database. Refuses while anything is still connected — a pytest run
# live in another worktree, or a psql someone left open — because dropping it
# out from under a running session turns a disk-hygiene chore into a failed test
# run somebody else has to debug.
drop_test_db() {
  local name="$1" conns
  is_wt_test_db "$name" || { warn "  refusing to drop '$name' (not a ${WT_TEST_DB_PREFIX}* database)"; return 1; }
  conns="$(db_query "SELECT count(*) FROM pg_stat_activity WHERE datname = '${name}';" | tr -d '[:space:]')"
  if [[ "$conns" =~ ^[0-9]+$ ]] && (( conns > 0 )); then
    warn "  $name: $conns active connection(s) — left in place"
    return 1
  fi
  db_query "DROP DATABASE IF EXISTS \"${name}\";" >/dev/null
  return 0
}

# Drop a worktree's whole test-DB family. Best-effort and always returns 0: this
# runs as the last step of a teardown that has already succeeded.
drop_worktree_test_dbs() {
  local base="$1" dropped=0 d
  [[ -n "$base" ]] || return 0
  is_wt_test_db "$base" || return 0
  db_available || return 0
  for d in $(test_db_family "$base"); do
    if drop_test_db "$d"; then
      dropped=$((dropped + 1))
    fi
  done
  if (( dropped > 0 )); then
    ok "  dropped $dropped test database$([[ "$dropped" == 1 ]] && echo "" || echo "s") ($base)"
  fi
  return 0
}

# Test databases with no live worktree behind them. A worktree owns its base
# name and every `_gw<N>` worker under it; anything else is an orphan.
orphan_test_dbs() {
  local live="" path base d
  while IFS= read -r path; do
    [[ -z "$path" || "$path" == "$REPO_ROOT" ]] && continue
    base="$(worktree_test_db "$path")"
    [[ -n "$base" ]] && live="${live}${base}
"
  done < <(git -C "$REPO_ROOT" worktree list --porcelain | awk '/^worktree /{print $2}')

  db_list_wt | while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    local owned=1
    while IFS= read -r base; do
      [[ -z "$base" ]] && continue
      if [[ "$d" == "$base" || "$d" == "${base}_gw"* ]]; then owned=0; break; fi
    done <<EOF
$live
EOF
    (( owned == 1 )) && printf '%s\n' "$d"
  done
}

lock_available() { command -v glab >/dev/null 2>&1; }

# Extract the issue number encoded in a branch name (`feat/1462-foo` → 1462), or
# empty for a branch with no leading issue number (`chore/some-slug`). This is the
# single source for "which issue does this worktree lock", used by new/remove/prune.
issue_from_branch() {
  local branch="$1"
  if [[ "$branch" =~ ^[a-z]+/([0-9]+)- ]]; then printf "%s" "${BASH_REMATCH[1]}"; fi
}

# Print "locked" if issue $1 currently carries the lock label, else "".
issue_is_locked() {
  glab issue view "$1" --output json 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); print('locked' if '${WT_LOCK_LABEL}' in (d.get('labels') or []) else '')" \
    2>/dev/null || true
}

# Print "closed" if issue $1's GitLab state is closed, else "" — including on
# lookup failure (best-effort, same fail-open shape as issue_is_locked). Used
# by `wt remove` to decide whether it's safe to strip the lock label: closed
# means the work is done and the claim can clear; still-open means someone
# removed a worktree without merging, and the label should keep signaling
# that the issue is spoken for.
issue_is_closed() {
  glab issue view "$1" --output json 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); print('closed' if d.get('state') == 'closed' else '')" \
    2>/dev/null || true
}

# Print the body of the most recent check-out comment on issue $1 (best effort;
# empty if none found or the comment JSON shape isn't recognized).
last_checkout_note() {
  glab issue view "$1" --comments --output json 2>/dev/null | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
notes=d.get('Notes') or d.get('notes') or []
hits=[(n.get('body') or '') for n in notes if '🔒 checked out' in (n.get('body') or '')]
print(hits[-1] if hits else '')
" 2>/dev/null || true
}

# Create the scoped lock label if the project doesn't have it yet (idempotent).
ensure_lock_label() {
  glab label list 2>/dev/null | grep -qF "$WT_LOCK_LABEL" && return 0
  glab label create -n "$WT_LOCK_LABEL" -c "#ec9a29" \
    -d "Checked out by an agent/worktree (scripts/wt) — do not grab in parallel" \
    >/dev/null 2>&1 || true
}

# Apply the lock to issue $1: label + check-out comment recording branch/worktree.
apply_lock() {
  local issue="$1" branch="$2" path="$3" ts
  ensure_lock_label
  glab issue update "$issue" --label "$WT_LOCK_LABEL" >/dev/null 2>&1 \
    || warn "could not apply '$WT_LOCK_LABEL' to #$issue (check glab auth)"
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  glab issue note "$issue" \
    -m "🔒 checked out ${ts} · branch \`${branch}\` · worktree \`${path}\`" \
    >/dev/null 2>&1 || warn "could not post check-out comment to #$issue"
}

# Release the lock on issue $1: remove the label and post a release comment.
clear_lock() {
  local issue="$1" branch="$2" ts
  glab issue update "$issue" --unlabel "$WT_LOCK_LABEL" >/dev/null 2>&1 || true
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  glab issue note "$issue" -m "🔓 released ${ts} · branch \`${branch}\`" >/dev/null 2>&1 || true
}

# Guard used by new/claim: die if $1 is already checked out and --force wasn't given.
# $2 is the force flag (non-empty = force). No-op when glab is unavailable.
assert_claimable() {
  local issue="$1" force="$2" note
  lock_available || { warn "glab unavailable — the #$issue advisory label won't be set, but the local worktree dir + prune grace window still prevent a parallel agent from stomping this work"; return 0; }
  if [[ "$(issue_is_locked "$issue")" == "locked" && -z "$force" ]]; then
    err "issue #$issue is already checked out (label '$WT_LOCK_LABEL')."
    note="$(last_checkout_note "$issue")"
    [[ -n "$note" ]] && dim "  $note"
    die "another agent/worktree is likely on it. Re-run with --force to take it over."
  fi
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_new() {
  local input="" force="" adr_flag="" no_adr=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)  force="1"; shift ;;
      --adr)    adr_flag="1"; shift ;;
      --no-adr) no_adr="1"; shift ;;
      *)        [[ -z "$input" ]] && input="$1"; shift ;;
    esac
  done
  [[ -n "$input" ]] || die "usage: wt new <issue|branch-name> [--force] [--adr|--no-adr]"
  local branch
  branch="$(derive_branch_name "$input")"
  local short_name="${branch##*/}"
  local target_path="${WT_BASE}/${short_name}"
  local issue
  issue="$(issue_from_branch "$branch")"

  # WIP cap check.
  local count
  count="$(wt_count)"
  if (( count >= WT_CAP )); then
    die "WIP cap reached (${count}/${WT_CAP}). Finish or remove one before starting another. Override with TRUEPPM_WT_CAP if you must."
  fi
  if (( count >= WT_WARN )); then
    warn "${count}/${WT_CAP} active worktrees — you're approaching the WIP cap"
  fi

  # Issue check-out lock: refuse fast (before touching the filesystem) if a
  # parallel agent already holds this issue, unless the caller forces a takeover.
  [[ -n "$issue" ]] && assert_claimable "$issue" "$force"

  # Fetch latest origin/main so the new branch is up-to-date.
  git -C "$REPO_ROOT" fetch origin main --quiet

  # Create the worktree.
  mkdir -p "$WT_BASE"
  if [[ -e "$target_path" ]]; then
    die "path already exists: $target_path"
  fi
  if git -C "$REPO_ROOT" rev-parse --verify "$branch" >/dev/null 2>&1; then
    git -C "$REPO_ROOT" worktree add "$target_path" "$branch"
  else
    # --no-track: the new branch must NOT adopt origin/main as its upstream.
    # If it did, `wt prune` could not tell a fresh 0-commit worktree from a
    # merged-and-deleted branch — both look like an ancestor of origin/main with
    # no origin/<branch> — and would false-prune the fresh one out from under a
    # running agent. The branch's real upstream is set on its first `git push -u`.
    git -C "$REPO_ROOT" worktree add --no-track "$target_path" -b "$branch" origin/main
  fi

  # Belt-and-suspenders: on the existing-branch path (or any git that ignores
  # --no-track), strip an origin/main upstream if one slipped through, for the
  # same false-prune reason above.
  if [[ "$(git -C "$REPO_ROOT" config --get "branch.${branch}.merge" 2>/dev/null || true)" == "refs/heads/main" ]]; then
    git -C "$REPO_ROOT" branch --unset-upstream "$branch" 2>/dev/null || true
  fi

  # Symlink shared dev deps. Both are absent in a fresh worktree.
  if [[ -e "$REPO_ROOT/packages/api/.venv" ]]; then
    ln -s "$REPO_ROOT/packages/api/.venv" "$target_path/packages/api/.venv"
    ok "symlinked packages/api/.venv → main checkout"
  else
    warn "main checkout has no packages/api/.venv; pre-push will fail until you create one"
  fi
  if [[ -e "$REPO_ROOT/packages/web/node_modules" ]]; then
    ln -s "$REPO_ROOT/packages/web/node_modules" "$target_path/packages/web/node_modules"
    ok "symlinked packages/web/node_modules → main checkout"
  else
    warn "main checkout has no packages/web/node_modules; run 'cd packages/web && npm ci' in main first"
  fi

  # Per-worktree Postgres test-DB name so parallel `pytest` runs don't collide
  # on one shared `test_trueppm` (which previously forced an out-of-band flock
  # mutex — and flock(1) is absent on macOS). Sanitized to a valid identifier and
  # length-capped; honored by packages/api/src/trueppm_api/settings/dev.py.
  local db_slug
  db_slug="$(printf '%s' "$short_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_' | cut -c1-32)"
  local test_db="test_trueppm_wt_${db_slug}"

  # .envrc for direnv users. No-op if direnv isn't installed.
  cat > "$target_path/.envrc" <<EOF
# Auto-generated by scripts/wt. Reuses the running Docker stack from the main
# checkout via the shared compose project name. Without this, make pre-push
# can't find the running api container.
export COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME_DEFAULT}
# Isolated test database for this worktree so pytest can run in parallel with
# other worktrees without colliding on a shared test DB. Honored by
# packages/api/src/trueppm_api/settings/dev.py.
export TRUEPPM_TEST_DB=${test_db}
EOF

  # Note: we deliberately do NOT write to .git/worktrees/<name>/info/exclude —
  # git treats info/exclude as shared across all worktrees (it reads from the
  # common gitdir, not the per-worktree subdir). The dirty check in `wt remove`
  # filters out our auto-created files instead.

  # Owner/freshness marker — powers the prune grace window and the `wt list` AGE
  # column so a parallel agent's fresh worktree is visibly, structurally protected.
  write_owner_marker "$target_path" "$branch" "$issue"

  # Auto-reserve an ADR for feature branches — the collision-prone case, since each
  # parallel feature agent's architect step writes an ADR. fix/chore/docs skip it
  # (they rarely add one) unless --adr; --no-adr suppresses it for a feature branch
  # that won't. Reserving here, at creation, is what makes the number collision-free
  # before the agent ever runs architect.
  local reserve_adr=""
  case "$branch" in feat/*) reserve_adr="1" ;; esac
  [[ -n "$adr_flag" ]] && reserve_adr="1"
  [[ -n "$no_adr" ]] && reserve_adr=""
  if [[ -n "$reserve_adr" ]]; then
    ledger_lock || true
    local adr_num; adr_num="$(next_adr_number)"
    ledger_record adr - "$adr_num" "$branch"
    ledger_unlock
    stamp_reservation "$target_path" adr "$adr_num"
    ok "reserved ADR-$adr_num for this worktree (use it for docs/adr/${adr_num}-<slug>.md)"
  fi

  # Check out the issue now that the worktree exists (best-effort GitLab lock).
  if [[ -n "$issue" ]] && lock_available; then
    apply_lock "$issue" "$branch" "$target_path"
    if [[ -n "$force" ]]; then
      ok "took over check-out of #$issue (forced; '$WT_LOCK_LABEL' applied)"
    else
      ok "checked out #$issue ('$WT_LOCK_LABEL' applied)"
    fi
  fi

  ok "created worktree at $target_path on branch $branch"
  say ""
  dim "  cd $target_path"
  if command -v direnv >/dev/null 2>&1; then
    dim "  direnv allow                           # picks up COMPOSE_PROJECT_NAME"
  else
    dim "  source .envrc                          # or set COMPOSE_PROJECT_NAME manually"
  fi
}

cmd_list() {
  local count
  count="$(wt_count)"
  printf "Active worktrees (%s/%s):\n\n" "$count" "$WT_CAP"
  if (( count > 0 )); then
    printf "  %-50s  %-6s  %-4s  %-6s  %s\n" "BRANCH" "ISSUE" "AGE" "PUSHED" "PATH"
  fi
  # A bash loop (not awk) so each row can carry the owner-marker age, the issue
  # number, and an honest pushed? flag — the transparency that lets an operator
  # or agent see at a glance whose worktree is whose and which are safe to reap.
  local path branch issue pushed
  while IFS= read -r path; do
    [[ -z "$path" || "$path" == "$REPO_ROOT" ]] && continue
    branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    issue="$(issue_from_branch "$branch")"
    [[ -n "$issue" ]] && issue="#$issue" || issue="—"
    branch_pushed "$branch" && pushed="yes" || pushed="no"
    printf "  %-50s  %-6s  %-4s  %-6s  %s\n" \
      "$branch" "$issue" "$(humanize_age "$(worktree_age_seconds "$path")")" "$pushed" "$path"
  done < <(git -C "$REPO_ROOT" worktree list --porcelain | awk '/^worktree /{print $2}')

  # Outstanding ADR / migration reservations held by active branches.
  if [[ -s "$WT_LEDGER" ]]; then
    say ""
    printf "  %-9s  %-14s  %-6s  %s\n" "RESERVED" "APP" "NUMBER" "BRANCH"
    awk -F'\t' '{ printf "  %-9s  %-14s  %-6s  %s\n", $1, ($2=="-"?"—":$2), $3, $4 }' "$WT_LEDGER"
  fi

  say ""
  if (( count == 0 )); then
    dim "  (none — use 'wt new <issue>' to create one)"
  elif (( count >= WT_WARN )); then
    warn "approaching WIP cap (${count}/${WT_CAP}); finish or remove some before starting more"
  fi
}

cmd_remove() {
  [[ $# -ge 1 ]] || die "usage: wt remove <issue|name>"
  local needle="$1"
  local path
  path="$(find_worktree "$needle")"
  [[ -n "$path" ]] || die "no worktree matches '$needle'"

  # Capture the issue before we remove the tree, so we can release its check-out.
  local rm_branch rm_issue rm_test_db
  rm_branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  rm_issue="$(issue_from_branch "$rm_branch")"
  # Read the test DB name from .envrc while it still exists — `git worktree
  # remove` deletes it, and the name is the only handle on the database (#3270).
  rm_test_db="$(worktree_test_db "$path")"

  local force="${2:-}"
  if [[ -d "$path" ]]; then
    # Tracked changes (staged or unstaged) — never auto-removable.
    local tracked_dirty
    tracked_dirty="$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')"
    if (( tracked_dirty > 0 )) && [[ "$force" != "--force" ]]; then
      die "$path has $tracked_dirty uncommitted change(s) to tracked files. Commit/push first, or re-run with --force."
    fi
    # Untracked files — auto-created ones (.envrc + our two symlinks) are
    # expected; anything else is the user's work-in-progress that we should
    # refuse to drop silently.
    local unexpected_untracked
    # grep -v exits 1 on no-match, which combined with pipefail would kill the
    # script. Trailing `|| true` keeps the count at 0 in the clean case.
    unexpected_untracked="$( ( git -C "$path" status --porcelain 2>/dev/null \
      | awk '/^\?\? / {print $2}' \
      | grep -Ev '^(\.envrc|\.wt-owner|\.wt-reservation|packages/api/\.venv|packages/web/node_modules)$' \
      || true ) | wc -l | tr -d ' ')"
    if (( unexpected_untracked > 0 )) && [[ "$force" != "--force" ]]; then
      die "$path has $unexpected_untracked untracked file(s) beyond the auto-created set. Stash/commit them, or re-run with --force."
    fi
  fi

  # Always force git's own remove — the symlinks + .envrc we created are
  # "untracked" from git's POV and would otherwise block removal.
  git -C "$REPO_ROOT" worktree remove --force "$path"
  ok "removed worktree $path"

  # Drop the Postgres test DB this worktree owned. pytest-django only drops it on
  # a clean exit, so an interrupted run leaves it stranded forever (#3270).
  drop_worktree_test_dbs "$rm_test_db"

  # Free any ADR / migration numbers this branch reserved but may not have used.
  [[ -n "$rm_branch" ]] && ledger_release_branch "$rm_branch"

  # Release the issue check-out (best-effort) — but only strip the lock label
  # when GitLab shows the issue as closed. This is the automated half of
  # #2693: 24 closed 0.4 issues were found still carrying `status::wip`
  # because nothing cleared it after the worktree that claimed them was gone,
  # and the pre-push collision gate then warns on work that finished weeks
  # ago. Gating on closed state (rather than clearing unconditionally) also
  # protects the inverse case named in #2693: if `wt remove` runs on
  # abandoned/unmerged work — someone tears down the worktree without
  # merging — the issue is still open and the label is the only signal left
  # that it's spoken for, so leave it alone. `clear_lock`'s --unlabel is
  # idempotent (a no-op if the label is already absent), so this is safe to
  # run even if the label was already cleared by some other path.
  if [[ -n "$rm_issue" ]] && lock_available; then
    if [[ "$(issue_is_closed "$rm_issue")" == "closed" ]]; then
      clear_lock "$rm_issue" "$rm_branch"
      ok "released check-out of #$rm_issue (issue closed)"
    else
      dim "  #$rm_issue still open — leaving '$WT_LOCK_LABEL' in place"
    fi
  fi
}

cmd_prune() {
  # Remove worktrees whose branches have been merged and deleted on origin.
  # Conservative by default: refuses to remove a worktree with uncommitted
  # tracked changes or unexpected untracked files. Pass --force to override
  # those guards (you really shouldn't).
  local force="${1:-}"

  say "Fetching origin with --prune to discover deleted remote branches…"
  git -C "$REPO_ROOT" fetch --prune --quiet origin

  local pruned=0
  local skipped=0
  local kept=0

  # Iterate over every worktree except the main checkout.
  while IFS= read -r path; do
    [[ -z "$path" || "$path" == "$REPO_ROOT" ]] && continue

    # Branch this worktree is on. If detached HEAD, skip (no upstream to compare).
    local branch
    branch="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
      dim "  $path: detached HEAD — skipped"
      kept=$((kept + 1))
      continue
    fi

    # Grace window: never reap a very fresh worktree. A parallel agent may be
    # mid-startup with nothing committed or pushed yet — the classic false-prune
    # that stomps another session's work. --force overrides.
    if [[ "$force" != "--force" ]] && within_grace "$path"; then
      dim "  $branch: created $(humanize_age "$(worktree_age_seconds "$path")") ago (< ${WT_GRACE_MIN}m grace) — skipped (fresh, may be in use)"
      kept=$((kept + 1))
      continue
    fi

    # Did this branch ever have an upstream? If not, it's local-only WIP.
    if ! git -C "$REPO_ROOT" config --get "branch.${branch}.remote" >/dev/null 2>&1; then
      dim "  $branch: never pushed — skipped"
      kept=$((kept + 1))
      continue
    fi

    # Does the remote branch still exist? (origin/<branch> resolvable.)
    if git -C "$REPO_ROOT" rev-parse --verify --quiet "origin/${branch}" >/dev/null; then
      dim "  $branch: still on origin — skipped"
      kept=$((kept + 1))
      continue
    fi

    # Remote gone. Is the local tip an ancestor of origin/main (= merged)?
    # If not, the branch was deleted without merging — refuse to drop the
    # work silently.
    if ! git -C "$REPO_ROOT" merge-base --is-ancestor "$branch" origin/main 2>/dev/null; then
      warn "  $branch: remote gone but local commits NOT in origin/main — skipped (force-delete manually if intentional)"
      kept=$((kept + 1))
      continue
    fi

    # Safe to consider for removal. Apply the same dirty-check as cmd_remove.
    local tracked_dirty unexpected_untracked
    tracked_dirty="$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')"
    unexpected_untracked="$( ( git -C "$path" status --porcelain 2>/dev/null \
      | awk '/^\?\? / {print $2}' \
      | grep -Ev '^(\.envrc|\.wt-owner|\.wt-reservation|packages/api/\.venv|packages/web/node_modules)$' \
      || true ) | wc -l | tr -d ' ')"

    if [[ "$force" != "--force" ]] && (( tracked_dirty > 0 || unexpected_untracked > 0 )); then
      warn "  $branch: merged but has local work (tracked=$tracked_dirty, untracked=$unexpected_untracked) — skipped (use --force to drop)"
      skipped=$((skipped + 1))
      continue
    fi

    # Same as cmd_remove: the test DB name lives in .envrc, which the removal
    # below deletes, so read it first (#3270).
    local prune_test_db
    prune_test_db="$(worktree_test_db "$path")"
    git -C "$REPO_ROOT" worktree remove --force "$path"
    ok "  $branch: removed (merged to main, remote gone)"
    drop_worktree_test_dbs "$prune_test_db"
    # Free any numbers this branch reserved (merged ADRs/migrations are now on disk;
    # unused reservations should not linger and block reuse).
    ledger_release_branch "$branch"
    # Release the issue check-out for the pruned branch (best-effort).
    local prune_issue
    prune_issue="$(issue_from_branch "$branch")"
    [[ -n "$prune_issue" ]] && lock_available && clear_lock "$prune_issue" "$branch"
    pruned=$((pruned + 1))
  done < <(git -C "$REPO_ROOT" worktree list --porcelain | awk '/^worktree /{print $2}')

  say ""
  say "Pruned: $pruned. Skipped (had local work): $skipped. Kept: $kept."
}

cmd_doctor() {
  say "TruePPM worktree health"
  say "======================="
  say ""

  # Are we currently inside a worktree (not the main checkout)?
  local here="$CURRENT_TOPLEVEL"
  if [[ "$here" == "$REPO_ROOT" ]]; then
    dim "  not currently in a worktree (in main checkout)"
  else
    say "  current worktree: $here"
    # Symlink checks
    for link in "packages/api/.venv" "packages/web/node_modules"; do
      if [[ -L "$here/$link" ]]; then
        local target
        target="$(readlink "$here/$link")"
        if [[ -e "$target" ]]; then
          ok "  $link → $target"
        else
          err "  $link → $target (broken)"
        fi
      elif [[ -e "$here/$link" ]]; then
        warn "  $link exists but is NOT a symlink (re-created locally; will waste disk)"
      else
        warn "  $link missing"
      fi
    done
    # COMPOSE_PROJECT_NAME check
    if [[ "${COMPOSE_PROJECT_NAME:-}" == "$COMPOSE_PROJECT_NAME_DEFAULT" ]]; then
      ok "  COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME_DEFAULT}"
    else
      warn "  COMPOSE_PROJECT_NAME not set; pre-push won't find the shared docker stack. Run: source .envrc"
    fi
  fi

  # Docker stack reachable? Check that the API container is up by name
  # (compose project = trueppm → container name = trueppm-api-1).
  if command -v docker >/dev/null 2>&1; then
    local api_status
    api_status="$(docker ps --filter "name=^${COMPOSE_PROJECT_NAME_DEFAULT}-api-1$" --format '{{.Status}}' 2>/dev/null || true)"
    if [[ -n "$api_status" ]]; then
      ok "  docker container ${COMPOSE_PROJECT_NAME_DEFAULT}-api-1 is up ($api_status)"
    else
      warn "  no running ${COMPOSE_PROJECT_NAME_DEFAULT}-api-1 container; run 'make up' in the main checkout"
    fi
  else
    warn "  docker not installed; can't verify stack"
  fi

  # Shared-stash warning (#3110). `git stash` writes refs/stash in the git COMMON
  # dir, so with several worktrees active an entry here may belong to a session
  # that is still using it — and a `git stash pop` from the wrong worktree applies
  # it, then drops it. Name the branch each entry was made on so the owner is
  # identifiable before anyone reaches for pop.
  say ""
  local stash_count
  stash_count="$(git -C "$REPO_ROOT" stash list 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "${stash_count:-0}" -gt 0 ]]; then
    if [[ "$(wt_count)" -gt 0 ]]; then
      warn "  refs/stash has ${stash_count} entr$([[ "$stash_count" == 1 ]] && echo y || echo ies) and is SHARED by every worktree:"
      git -C "$REPO_ROOT" stash list 2>/dev/null | sed 's/^/      /' >&2
      warn "  a 'git stash pop' from any worktree takes the newest of these, whoever made it."
      warn "  use 'scripts/wt stash' instead — it is per-worktree and cannot be reached from elsewhere."
    else
      dim "  refs/stash has ${stash_count} entry/entries (only the main checkout is active)"
    fi
  else
    ok "  refs/stash is empty"
  fi
  local own_ref
  own_ref="$(wt_stash_ref)"
  if wt_stash_has_entries; then
    ok "  ${own_ref} has $(wt_stash_entries | wc -l | tr -d ' ') private entr$([[ "$(wt_stash_entries | wc -l | tr -d ' ')" == 1 ]] && echo y || echo ies)"
  fi

  # Orphaned test databases (#3270). `remove`/`prune` now drop the DB they
  # caused to exist, but that only stops the bleeding — anything stranded by an
  # interrupted pytest run, or by a worktree removed before this shipped, is
  # still on disk with nothing pointing at it. This is the half that finds them.
  # Orphaned reservations (#3283). A leaked row still counts toward the next
  # free number — `next_adr_number` maxes over the tree, origin/main AND the
  # ledger — so it silently pushes every future ADR up by one, attributed to a
  # branch nobody can find.
  say ""
  local res_orphans res_count
  res_orphans="$(orphan_reservations)"
  res_count="$(printf '%s' "$res_orphans" | grep -c . || true)"
  if [[ "${res_count:-0}" -gt 0 ]]; then
    warn "  ${res_count} reservation(s) held by a branch that no longer exists:"
    printf '%s\n' "$res_orphans" \
      | awk -F'\t' '{ printf "      %s %s (%s) — branch %s\n", $1, $3, ($2=="-"?"—":$2), $4 }' >&2
    warn "  each one still raises the next free number. Release with: scripts/wt release-reservation <branch>"
  else
    ok "  no orphaned reservations"
  fi

  say ""
  if db_available; then
    local orphans orphan_count in_list
    orphans="$(orphan_test_dbs)"
    orphan_count="$(printf '%s' "$orphans" | grep -c . || true)"
    if [[ "${orphan_count:-0}" -gt 0 ]]; then
      in_list="$(printf '%s\n' "$orphans" | sed "s/.*/'&'/" | paste -sd, -)"
      warn "  ${orphan_count} orphaned test database(s), $(db_total_size "$in_list") total, with no live worktree:"
      printf '%s\n' "$orphans" | sed 's/^/      /' >&2
      warn "  drop them with: scripts/wt prune-dbs"
    else
      ok "  no orphaned ${WT_TEST_DB_PREFIX}* databases"
    fi
  else
    dim "  Postgres container ${WT_DB_CONTAINER} not running — skipped test-DB orphan check"
  fi

  say ""
  say "WIP: $(wt_count)/$WT_CAP active worktrees"
}

# Drop every test database with no live worktree behind it. The recovery half of
# #3270: `remove`/`prune` keep the set from growing, this reclaims what already
# leaked. Deliberately a separate command rather than a step inside `prune` —
# `prune` reaps worktrees and should not also delete databases nobody asked it
# about.
cmd_prune_dbs() {
  local force="${1:-}"
  if ! db_available; then
    die "Postgres container ${WT_DB_CONTAINER} is not running; start the stack with 'make up'"
  fi

  local orphans orphan_count
  orphans="$(orphan_test_dbs)"
  orphan_count="$(printf '%s' "$orphans" | grep -c . || true)"
  if [[ "${orphan_count:-0}" -eq 0 ]]; then
    ok "no orphaned ${WT_TEST_DB_PREFIX}* databases"
    return 0
  fi

  local in_list
  in_list="$(printf '%s\n' "$orphans" | sed "s/.*/'&'/" | paste -sd, -)"
  say "${orphan_count} orphaned test database(s), $(db_total_size "$in_list") total:"
  printf '%s\n' "$orphans" | sed 's/^/  /'
  say ""

  if [[ "$force" != "--yes" ]]; then
    printf "Drop all %s? [y/N] " "$orphan_count"
    local reply=""
    read -r reply || true
    case "$reply" in
      y|Y|yes|YES) ;;
      *) say "Aborted; nothing dropped."; return 0 ;;
    esac
  fi

  local dropped=0 kept=0 d
  while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    if drop_test_db "$d"; then
      dropped=$((dropped + 1))
    else
      kept=$((kept + 1))
    fi
  done <<EOF
$orphans
EOF

  say ""
  ok "Dropped: $dropped. Kept (in use or not wt-owned): $kept."
}

# Check out an issue without creating a worktree — for "I picked it up but
# haven't started" so a parallel agent sees the claim immediately.
cmd_claim() {
  local issue="" force=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force="1"; shift ;;
      *)       [[ -z "$issue" ]] && issue="$1"; shift ;;
    esac
  done
  [[ "$issue" =~ ^[0-9]+$ ]] || die "usage: wt claim <issue-number> [--force]"
  lock_available || die "glab not available — cannot claim #$issue"
  assert_claimable "$issue" "$force"
  apply_lock "$issue" "(not started)" "(claim only — no worktree yet)"
  if [[ -n "$force" ]]; then
    ok "took over check-out of #$issue (forced; no worktree yet)"
  else
    ok "checked out #$issue ('$WT_LOCK_LABEL' applied; no worktree yet)"
  fi
}

# Manually release an issue check-out (e.g. a `claim` you never turned into a
# worktree, or a stale lock from a crashed session).
# The actionable half of doctor's orphan-reservation warning. A warning that
# names no way out is a direction to an empty page.
cmd_release_reservation() {
  [[ $# -ge 1 ]] || die "usage: wt release-reservation <branch>"
  local branch="$1"
  [[ -f "$WT_LEDGER" ]] || { ok "no reservation ledger — nothing to release"; return 0; }
  local rows
  rows="$(awk -F'\t' -v b="$branch" '$4 == b' "$WT_LEDGER" 2>/dev/null || true)"
  [[ -n "$rows" ]] || die "no reservation rows for branch '$branch'"
  # Refuse while the branch still exists: the row is doing its job then, and
  # releasing it would hand the same number to the next worktree.
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch" \
     || git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    die "branch '$branch' still exists — its reservation is live. Use 'wt remove' instead."
  fi
  printf '%s\n' "$rows" | awk -F'\t' '{ printf "  releasing %s %s (branch %s)\n", $1, $3, $4 }' >&2
  ledger_release_branch "$branch"
  ok "released $(printf '%s\n' "$rows" | grep -c .) reservation row(s) for '$branch'"
}

cmd_release() {
  [[ $# -ge 1 ]] || die "usage: wt release <issue-number>"
  local issue="$1"
  [[ "$issue" =~ ^[0-9]+$ ]] || die "release needs a numeric issue number"
  lock_available || die "glab not available — cannot release #$issue"
  clear_lock "$issue" "(manual release)"
  ok "released check-out of #$issue"
}

# Reserve the next free ADR or migration number atomically. The reserved number is
# printed on STDOUT (zero-padded, nothing else) and the human context on STDERR, so
# it composes cleanly:  NUM="$(scripts/wt reserve adr)". Records the claim in the
# shared ledger and the current worktree's .wt-reservation marker.
cmd_reserve() {
  local kind="${1:-}" branch number
  branch="$(git -C "$CURRENT_TOPLEVEL" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
  case "$kind" in
    adr)
      ledger_lock || true
      number="$(next_adr_number)"
      ledger_record adr - "$number" "$branch"
      ledger_unlock
      stamp_reservation "$CURRENT_TOPLEVEL" adr "$number"
      printf "wt: reserved ADR-%s for %s — create docs/adr/%s-<slug>.md\n" "$number" "$branch" "$number" >&2
      printf '%s\n' "$number"
      ;;
    migration)
      local app="${2:-}"
      [[ -n "$app" ]] || die "usage: wt reserve migration <app>"
      [[ -d "$REPO_ROOT/packages/api/src/trueppm_api/apps/${app}/migrations" ]] \
        || die "unknown app '$app' (no packages/api/src/trueppm_api/apps/${app}/migrations)"
      ledger_lock || true
      number="$(next_migration_number "$app")"
      ledger_record migration "$app" "$number" "$branch"
      ledger_unlock
      stamp_reservation "$CURRENT_TOPLEVEL" migration "$number" "$app"
      printf "wt: reserved %s migration %s for %s\n" "$app" "$number" "$branch" >&2
      printf '%s\n' "$number"
      ;;
    ""|help|-h|--help)
      die "usage: wt reserve <adr | migration <app>>" ;;
    *)
      die "unknown reserve kind '$kind' (expected: adr | migration <app>)" ;;
  esac
}

# Worktree-private stash. See the "Worktree-private stash" helper block above for
# why `git stash` cannot be used here.
cmd_stash() {
  local sub="${1:-push}"
  case "$sub" in push|pop|apply|list|drop|show) shift || true ;; *) sub="push" ;; esac

  local ref slug
  ref="$(wt_stash_ref)"; slug="$(wt_stash_slug)"

  case "$sub" in
    push)
      local msg="${1:-}" commit
      [[ -n "$msg" ]] || msg="wt-stash on $(git -C "$CURRENT_TOPLEVEL" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
      # `create` builds the stash commit and prints its sha WITHOUT writing any
      # ref — the whole reason a private stash is possible. Empty output means a
      # clean tree; that is not an error, but it must not be reported as a save.
      commit="$(git -C "$CURRENT_TOPLEVEL" stash create "$msg" 2>/dev/null || true)"
      if [[ -z "$commit" ]]; then
        say "wt: nothing to stash — the worktree is clean"
        return 0
      fi
      # The reflog IS the stack — each push is one entry, newest first, exactly
      # like refs/stash. `--create-reflog` is required: git only auto-logs refs
      # under refs/heads, refs/remotes, refs/notes and HEAD unless
      # core.logAllRefUpdates=always, and a custom namespace is none of those.
      # Without it the ref still moves but every earlier entry is unreachable, so
      # `list` comes back empty and `pop` cannot find the previous entry to
      # restore — the stack silently becomes a single slot.
      git -C "$CURRENT_TOPLEVEL" update-ref --create-reflog -m "$msg" "$ref" "$commit"
      # Match `git stash push`: the working tree goes back to HEAD. Untracked
      # files are left alone, as `git stash create` does not capture them —
      # said out loud rather than silently differing from what push would do.
      git -C "$CURRENT_TOPLEVEL" reset --hard -q HEAD
      ok "stashed to ${ref} — restore with: scripts/wt stash pop"
      if [[ -n "$(git -C "$CURRENT_TOPLEVEL" ls-files --others --exclude-standard 2>/dev/null | head -n1)" ]]; then
        warn "untracked files were NOT stashed (git stash create does not capture them)"
      fi
      ;;

    pop|apply)
      wt_stash_has_entries || die "no wt stash entries for this worktree ($slug)"
      local target="${1:-$ref}"
      git -C "$CURRENT_TOPLEVEL" stash apply "$target" || die "apply failed — nothing was dropped; resolve, then: scripts/wt stash drop"
      if [[ "$sub" == "pop" ]]; then
        # Only reached when apply succeeded (the || die above returns otherwise),
        # so a conflicted restore never loses the entry.
        local prev
        prev="$(git -C "$CURRENT_TOPLEVEL" rev-parse --verify --quiet "${ref}@{1}" 2>/dev/null || true)"
        if [[ -n "$prev" ]]; then
          git -C "$CURRENT_TOPLEVEL" update-ref --create-reflog -m "wt-stash pop" "$ref" "$prev"
        else
          git -C "$CURRENT_TOPLEVEL" update-ref -d "$ref"
        fi
        ok "popped ${ref}"
      else
        ok "applied ${ref} (entry kept)"
      fi
      ;;

    list)
      if ! wt_stash_has_entries; then
        say "no wt stash entries for this worktree ($slug)"
      else
        say "wt stash entries for $slug:"
        wt_stash_entries | sed 's/^/  /'
      fi
      ;;

    show)
      wt_stash_has_entries || die "no wt stash entries for this worktree ($slug)"
      git -C "$CURRENT_TOPLEVEL" stash show -p "${1:-$ref}"
      ;;

    drop)
      wt_stash_has_entries || die "no wt stash entries for this worktree ($slug)"
      local prev
      prev="$(git -C "$CURRENT_TOPLEVEL" rev-parse --verify --quiet "${ref}@{1}" 2>/dev/null || true)"
      if [[ -n "$prev" ]]; then
        git -C "$CURRENT_TOPLEVEL" update-ref --create-reflog -m "wt-stash drop" "$ref" "$prev"
      else
        git -C "$CURRENT_TOPLEVEL" update-ref -d "$ref"
      fi
      ok "dropped the newest entry on ${ref}"
      ;;
  esac
}

cmd_help() {
  sed -n '2,/^$/p' "$0" | sed -E 's/^# ?//'
}

# The one-line usage for a single subcommand. `cmd_help` prints the whole header
# block; this is what `wt <sub> --help` and a rejected flag show.
subcmd_usage() {
  case "$1" in
    new)       echo "usage: wt new <issue|branch-name> [--force] [--adr|--no-adr]" ;;
    reserve)   echo "usage: wt reserve <adr | migration <app>>" ;;
    claim)     echo "usage: wt claim <issue-number> [--force]" ;;
    release)   echo "usage: wt release <issue-number>" ;;
    release-reservation) echo "usage: wt release-reservation <branch>" ;;
    stash)     echo "usage: wt stash [push [message] | pop | apply | list | drop | show]" ;;
    list)      echo "usage: wt list" ;;
    remove)    echo "usage: wt remove <issue|name> [--force]" ;;
    prune)     echo "usage: wt prune [--force]" ;;
    prune-dbs) echo "usage: wt prune-dbs [--yes]" ;;
    doctor)    echo "usage: wt doctor" ;;
    *)         echo "usage: wt <subcommand> — run 'wt help' for the full list" ;;
  esac
}

# Flags a given subcommand actually understands. Anything else beginning with a
# dash is a typo, not an argument.
#
# Read this off each cmd_* function's own parser, not off the header comment:
# `prune-dbs` gates on --yes (it prompts, it does not guard), while `remove`
# takes --force as its second positional. A flag missing here is not a cosmetic
# gap — the guard rejects it before the subcommand ever runs.
subcmd_flags() {
  case "$1" in
    new)                 echo "--force --adr --no-adr" ;;
    claim|prune|remove)  echo "--force" ;;
    prune-dbs)           echo "--yes" ;;
    *)                   echo "" ;;
  esac
}

# Guard a subcommand's arguments BEFORE its own parser sees them (#3283).
#
# Every parser below ends in a `*)` catch-all that takes an unrecognised token as
# the branch name / issue / needle. That is what made `wt new --help` create a
# branch called `feat/help`, a worktree, and an ADR reservation instead of
# printing usage — the top-level dispatcher does handle `--help`, but only as the
# FIRST argument.
#
# Two rules, and the second matters more than the one that prompted this: `--help`
# and `-h` print usage and exit 0, and **any other leading-dash token the
# subcommand does not declare is rejected**. A mistyped `--forse` silently
# becoming a branch name is the same bug wearing a worse name, and it would not
# have been caught by special-casing help alone.
wt_arg_guard() {
  local sub="$1"; shift
  local known; known=" $(subcmd_flags "$sub") "
  local a
  for a in "$@"; do
    case "$a" in
      -h|--help) subcmd_usage "$sub"; exit 0 ;;
      --)        return 0 ;;
      -*)
        [[ "$known" == *" $a "* ]] && continue
        err "unknown option: $a"
        subcmd_usage "$sub" >&2
        exit 2
        ;;
    esac
  done
}

# ---------------------------------------------------------------------------
# Dispatcher
# ---------------------------------------------------------------------------

case "${1:-help}" in
  new)     shift; wt_arg_guard new "$@";       cmd_new "$@" ;;
  reserve) shift; wt_arg_guard reserve "$@";   cmd_reserve "$@" ;;
  claim)   shift; wt_arg_guard claim "$@";     cmd_claim "$@" ;;
  # Only the sub-subcommand is guarded: `wt stash push "-- rebase notes"` is a
  # legitimate message, and a message is not a flag.
  stash)   shift; wt_arg_guard stash "${1:-}"; cmd_stash "$@" ;;
  release) shift; wt_arg_guard release "$@";   cmd_release "$@" ;;
  release-reservation) shift; wt_arg_guard release-reservation "$@"; cmd_release_reservation "$@" ;;
  list|ls) shift; wt_arg_guard list "$@";      cmd_list ;;
  remove|rm) shift; wt_arg_guard remove "$@";  cmd_remove "$@" ;;
  prune)   shift; wt_arg_guard prune "$@";     cmd_prune "$@" ;;
  prune-dbs) shift; wt_arg_guard prune-dbs "$@"; cmd_prune_dbs "$@" ;;
  doctor)  shift; wt_arg_guard doctor "$@";    cmd_doctor ;;
  help|--help|-h) cmd_help ;;
  *)       err "unknown subcommand: $1"; cmd_help; exit 2 ;;
esac
